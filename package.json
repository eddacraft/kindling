{
  "name": "kindling-monorepo",
  "version": "0.4.1",
  "type": "module",
  "private": true,
  "description": "Local memory and continuity engine for AI-assisted development",
  "keywords": [
    "ai",
    "memory",
    "context",
    "llm",
    "agent",
    "continuity",
    "local-first",
    "sqlite",
    "fts",
    "opencode",
    "pocketflow"
  ],
  "author": "eddacraft <hello@eddacraft.ai>",
  "homepage": "https://github.com/eddacraft/kindling#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eddacraft/kindling.git"
  },
  "bugs": {
    "url": "https://github.com/eddacraft/kindling/issues"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.20.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "type-check": "pnpm -r run type-check",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,md,yml,yaml}": [
      "oxfmt"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.93.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.6"
  }
}
